	int "Bench limit on |duty|, 1/10000 (0 = none)"
	default 0

config AP_HAL_ZEPHYR_MB_MAX_GAP_MS
	int "Control steps further apart than this: hard latch (the dead-man cuts at ~10 ms), ms"
	default 4

config AP_HAL_ZEPHYR_MB_ALLOW_MOCK
	bool "BENCH ONLY: allow arming with the mock sensors (motor power off)"
	depends on AP_HAL_ZEPHYR_MOCK_SENSORS

