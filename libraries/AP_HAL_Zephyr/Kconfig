# AP_HAL_Zephyr Kconfig options. Sourced from the app Kconfig after Kconfig.zephyr.

config AP_HAL_I2C_FORCE_MSG_RESTART
	bool "Force I2C_MSG_RESTART on write→read direction change"
	default y if SOC_POLARFIRE
	help
	  Append I2C_MSG_RESTART to every read that follows a write in the
	  same i2c_transfer(). Required by the MPFS MSS I2C controller;
	  STM32/nRF/SAMD handle the repeated start automatically and reject
	  the explicit flag.

config AP_HAL_I2C_FAST_THRESHOLD_HZ
	int "I2C bus_clock threshold (Hz) above which FAST mode is selected"
	default 400001 if SOC_POLARFIRE
	default 400000
	help
	  bus_clock > threshold → I2C_SPEED_FAST, else STANDARD.
	  On MPFS the FAST divisor lands at 293 kHz (post AHB halving) or
	  585 kHz raw — either way bus_clock=400000 has to stay STANDARD.

config AP_HAL_UART_PLIC_REARM
	bool "Re-arm UART IRQ on every TX write (AMP PLIC-reset workaround)"
	default y if SOC_POLARFIRE
	help
	  Adds an irq_enable() before every UART TX kick plus a periodic
	  watchdog. Recovers from OpenSBI's plic_cold_irqchip_init() clearing
	  all PLIC source enables a few seconds after Zephyr boots.
	  Harmless no-op on non-PLIC controllers.

config AP_HAL_UART_TX_BUF_SIZE
	int "UART driver TX ring buffer size (bytes, per instance)"
	default 32768
	help
	  Sized for a MAVLink-FTP param.pck burst plus GCS traffic.
	  Reduce on small-RAM targets that don't need FTP.

config AP_HAL_UART_SERIAL0_MIN_BAUD
	int "Serial0 minimum baud rate clamp (0 = no clamp)"
	default 0
	help
	  If > 0, clamps Serial0's baud upward. Keeps a stale SERIAL0_BAUD
	  param from dropping below the hardware link rate and locking out
	  the GCS.

config AP_HAL_GPIO_NUM_CONTROLLERS
	int "Number of GPIO controllers exposed to ArduPilot"
	default 3
	help
	  Number of ardupilot-gpio<N> DT aliases. Entries beyond the board's
	  count have nullptr devices (reads return 0, writes no-op).

config AP_HAL_ADC_BITS
	int "ADC resolution in bits"
	default 12
	help
	  Bit resolution for raw→voltage conversion. Must match the
	  resolution field in AnalogIn's adc_sequence.

config AP_HAL_BOARD_VOLTAGE_MV
	int "Board supply voltage in millivolts"
	default 3300
	help
	  Value reported by AnalogIn::board_voltage(); only relevant
	  when there is no VCC-monitor ADC channel.

config AP_HAL_ZEPHYR_CYCLE_CLOCK
	bool "AP_HAL::micros64()/millis64() from the hardware cycle counter"
	default n
	depends on !SMP
	help
	  y: microsecond resolution from a 64-bit extension of
	  k_cycle_get_32() (CycleClock.h). Needs a free-running counter and a
	  caller at least once per counter wrap period (the 1 kHz timer
	  thread). n: the kernel tick clock (k_uptime_ticks(), 1 ms at 1000
	  ticks/s), the previous behaviour.

config AP_HAL_ZEPHYR_DELAY_SLEEP_MIN_US
	int "Scheduler::delay_microseconds(): sleep for waits of at least N us (0 = always busy-wait)"
	default 0
	help
	  Waits this long or longer sleep whole ticks while a tick edge is
	  sure to come before the deadline and busy-wait the rest on the
	  microsecond clock (DelayCalc.h): the CPU is idle for the
	  lower-priority threads, the final busy-wait is about one tick. The
	  function returns after the requested time, never before; it is late
	  when the thread is not given the CPU at the deadline. Shorter waits
	  busy-wait. 0 keeps the busy-wait for every wait. Needs
	  AP_HAL_ZEPHYR_CYCLE_CLOCK.

config AP_HAL_ZEPHYR_IO_BELOW_MAIN
	bool "IO thread and PRIORITY_IO/storage threads below the main thread"
	default n
	help
	  n: the HAL IO thread (ap_io, 5) and thread_create(PRIORITY_IO) (7)
	  run above the main thread (8) and preempt the main loop, the
	  previous behaviour. y: ap_io and PRIORITY_IO at 12, PRIORITY_STORAGE
	  at 11, below main as in AP_HAL_ChibiOS; they run while the main
	  loop sleeps (use with AP_HAL_ZEPHYR_DELAY_SLEEP_MIN_US, or they only
	  get the time main blocks on I/O). Timer, RC in/out, CAN, SPI and
	  I2C classes stay above main.

config AP_HAL_ZEPHYR_MAIN_STUCK_MS
	int "Outputs to the safe state when the main loop is stuck for N ms (0 = off)"
	default 0
	help
	  The 1 kHz timer thread watches the main loop: no pass for more
	  than N ms outside an announced delay (expect_delay_ms(), and all of
	  setup()) calls ap_hal_zephyr_outputs_safe() (SafeState.h) once and
	  prints a message. AP_HAL_ChibiOS declares main_loop_stuck at 500 ms.
	  It does not catch a stuck timer thread or a dead core: that needs
	  a hardware watchdog.

config AP_HAL_ZEPHYR_MOTOR_BRIDGE
	bool "Motor bridge layer (ardupilot,motor-bridge devicetree node)"
	depends on PWM && GPIO && ADC
	help
	  The two motor RCOutput channels (servo-channels) drive the bridge
	  through the state machine in motor_bridge.c from a 1 kHz timer
	  process: ramps, reversal dead time, brakes, current foldback and trip,
	  current-sense plausibility, motor bus over-voltage, e-stop, a command
	  watchdog, hard and soft stops, the DRV_ARM dead-man square wave.

if AP_HAL_ZEPHYR_MOTOR_BRIDGE

