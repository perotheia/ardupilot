	int "Plausibility: current reading above this with the bridge off = fault, mA (0 = off)"
	default 3000

config AP_HAL_ZEPHYR_MB_IS_DEAD_DUTY
	int "Plausibility: duty above this (1/10000) ..."
	default 5000

config AP_HAL_ZEPHYR_MB_IS_DEAD_MIN_MA
	int "... with a reading below this = fault, mA"
	default 200

config AP_HAL_ZEPHYR_MB_IS_FAULT_MS
	int "Plausibility fault at this leaky count (+1 per implausible ms, -1 per plausible ms; 0 = off)"
	default 300

