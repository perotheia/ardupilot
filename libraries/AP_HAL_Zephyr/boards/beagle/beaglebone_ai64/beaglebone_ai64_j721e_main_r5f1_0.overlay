#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/*
 * BeagleBone AI-64, ArduPilot on MAIN R5FSS1 core0 (Zephyr 'ai64' branch,
 * lockstep) beside Linux + TI vision_apps (rebuilt without mcu3).
 *
 * Memory: TI's vision-apps overlay maps main_r5fss1_core0 to 0xa6000000
 * (+16 MB): dma 0xa6000000 1 MB (vrings, ipc shm), memory 0xa6100000 15 MB.
 * The MPU is TI's table (SoC early boot); its non-cacheable 2 MB IPC window
 * starts at chosen zephyr,ipc_shm (ddr0) and covers ipc shm, the resource
 * table and the RAM console (= remoteproc trace0).
 * DRAM (code, data, malloc heap): 8 MB at 0xa6800000. Milestone 1 fits; a
 * bigger carveout replaces ddr1 once it is in the Linux overlay.
 *
 * Serial ports:
 *   SERIAL0 = MAVLink2 over the RPMsg "rpmsg-tty" endpoint (/dev/ttyRPMSGn on
 *             Linux, module rpmsg_tty)
 *   SERIAL1 = UART8, P8_28 RX / P8_29 TX: ExpressLRS receiver in MAVLink mode
 *             (RC in RADIO_RC_CHANNELS + telemetry), 460800 baud
 *   SERIAL3 = UART6, P9_14 RX / P9_16 TX: u-blox GPS (the driver autobauds)
 * UART8/UART6 interrupts reach this core through R5FSS1_INTROUTER0 (routed by
 * the SoC code from ti,sci-ir-route, Zephyr 'ai64' branch); 48 MHz fck, the
 * ns16550 TI K3 code picks 13x/16x per baud (460800: 13x, +0.16 %).
 *
 * NOT UART4 on P9_37/P9_38: P9_33 and P9_35..P9_40 are the analog inputs
 * (MCU_ADC0, a 1.8 V domain), each shorted on the header to a 3.3 V digital
 * ball. They are analog-only and must never be muxed to a digital function.
 */
/ {
	chosen {
		zephyr,ram-console = &ramcon;
	};

	aliases {
		ardupilot-serial1 = &uart8;
		ardupilot-serial3 = &uart6;
	};

	ramcon: memory@a6180000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0xa6180000 DT_SIZE_K(64)>;
		zephyr,memory-region = "RAMCON";
	};
};

&ddr0 {
	reg = <0xa6000000 DT_SIZE_M(1)>;
};

&rsc_table {
	reg = <0xa6100000 DT_SIZE_K(512)>;
};

&ddr1 {
	reg = <0xa6800000 DT_SIZE_M(8)>;
};

&uart8 {
	/* with the analog-only header pins held Hi-Z (see the note above) */
	pinctrl-0 = <&uart8_default &analog_pins_hiz>;
	pinctrl-names = "default";
	current-speed = <460800>;
	status = "okay";
};

&uart6 {
	pinctrl-0 = <&uart6_default>;
	pinctrl-names = "default";
	current-speed = <38400>;
	status = "okay";
};

/*
 * Motor bridge (2x BTS7960, prototype pin table wc-hardware docs/pin-allocation.md), CONFIG_AP_HAL_ZEPHYR_MOTOR_BRIDGE:
 *   PWM_L_FWD EHRPWM0_A P8_19, PWM_L_REV EHRPWM0_B P8_13, PWM_R_FWD EHRPWM4_B P9_25, PWM_R_REV EHRPWM5_A P8_37
 *   GPIO2 (pads of GPIO0_n, VGPIO_SEL = GPIO2): EN_L P8_07 (15), EN_R P8_08 (14), BRAKE_L P8_09 (17, high =
 *   released), BRAKE_R P8_10 (16), DRV_ARM P8_14 (75, square wave into the dead-man monostable), ESTOP_SENSE
 *   P8_12 (59, high = e-stop open)
 *   MCU_ADC0 (1.8 V at the ball, the header is halved): IS_L_FWD AIN0 P9_39, IS_L_REV AIN1 P9_40, IS_R_FWD AIN4
 *   P9_33, IS_R_REV AIN5 P9_36, VMOT_SENSE AIN2 P9_37, VBAT_SENSE AIN6 P9_35 (both for the over-voltage gate; VBAT also for the battery monitor, later)
 *   Current scale: 11.6 mV/A at the ball (IBT-2 with 10k IS resistors; 6.3 mV/A with 1k): to be calibrated.
 *   Bus scale: 56 V per volt at the ball.
 */
&main_ctrl_mmr0 { status = "okay"; };
&ehrpwm0 { pinctrl-0 = <&ehrpwm0_default>; pinctrl-names = "default"; status = "okay"; };
&ehrpwm4 { pinctrl-0 = <&ehrpwm4_default>; pinctrl-names = "default"; status = "okay"; };
&ehrpwm5 { pinctrl-0 = <&ehrpwm5_default>; pinctrl-names = "default"; status = "okay"; };
&main_gpio2_0 { pinctrl-0 = <&motor_gpio_default>; pinctrl-names = "default"; status = "okay"; };
&main_gpio2_1 { status = "okay"; };
&main_gpio2_2 { status = "okay"; };

#define AI64_ADC_CH(n) channel@n { reg = <n>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_INTERNAL"; \
	zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <12>; }

&mcu_adc0 {
	status = "okay";
	AI64_ADC_CH(0);
	AI64_ADC_CH(1);
	AI64_ADC_CH(2);
	AI64_ADC_CH(4);
	AI64_ADC_CH(5);
	AI64_ADC_CH(6);
};

/ {
	motor_bridge: motor-bridge {
		compatible = "ardupilot,motor-bridge";
		pwms = <&ehrpwm0 0 PWM_USEC(50) PWM_POLARITY_NORMAL>, <&ehrpwm0 1 PWM_USEC(50) PWM_POLARITY_NORMAL>,
		       <&ehrpwm4 1 PWM_USEC(50) PWM_POLARITY_NORMAL>, <&ehrpwm5 0 PWM_USEC(50) PWM_POLARITY_NORMAL>;
		enable-gpios = <&main_gpio2_0 15 GPIO_ACTIVE_HIGH>, <&main_gpio2_0 14 GPIO_ACTIVE_HIGH>;
		brake-gpios = <&main_gpio2_0 17 GPIO_ACTIVE_HIGH>, <&main_gpio2_0 16 GPIO_ACTIVE_HIGH>;
		drv-arm-gpios = <&main_gpio2_2 11 GPIO_ACTIVE_HIGH>;
		estop-gpios = <&main_gpio2_1 27 GPIO_ACTIVE_HIGH>;
		io-channels = <&mcu_adc0 0>, <&mcu_adc0 1>, <&mcu_adc0 4>, <&mcu_adc0 5>, <&mcu_adc0 2>, <&mcu_adc0 6>;
		servo-channels = <0 2>;
		is-ma-per-mv = <86207 86207 86207 86207>;
		vmot-mv-per-mv = <56>;
	};
};
